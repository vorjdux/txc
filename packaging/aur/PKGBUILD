# Maintainer: Matheus Santos <vorj.dux@gmail.com>
#
# Binary package for the AUR: txc-bin. The release already ships a static
# build, so there is nothing to compile on the user's machine.
pkgname=txc-bin
_pkgname=txc
pkgver=@VERSION@
pkgrel=1
pkgdesc="Offline text utilities for the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/vorjdux/txc"
license=('MIT' 'Apache-2.0')
provides=('txc')
conflicts=('txc')
source_x86_64=("${_pkgname}-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/${_pkgname}-${pkgver}-linux-x86_64.tar.gz")
source_aarch64=("${_pkgname}-${pkgver}-aarch64.tar.gz::${url}/releases/download/v${pkgver}/${_pkgname}-${pkgver}-linux-aarch64.tar.gz")
sha256sums_x86_64=('@SHA256_LINUX_X86_64@')
sha256sums_aarch64=('@SHA256_LINUX_AARCH64@')

package() {
    cd "${_pkgname}-${pkgver}-linux-${CARCH}"

    install -Dm755 "${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${_pkgname}/README.md"
    install -Dm644 LICENSE-MIT "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE-MIT"
    install -Dm644 LICENSE-APACHE "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE-APACHE"

    install -Dm644 completions/txc.bash "${pkgdir}/usr/share/bash-completion/completions/${_pkgname}"
    install -Dm644 completions/_txc "${pkgdir}/usr/share/zsh/site-functions/_txc"
    install -Dm644 completions/txc.fish "${pkgdir}/usr/share/fish/vendor_completions.d/${_pkgname}.fish"
}
