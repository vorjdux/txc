#compdef txc

autoload -U is-at-least

_txc() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_txc_commands" \
"*::: :->txc" \
&& ret=0
    case $state in
    (txc)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:txc-command-$line[1]:"
        case $line[1] in
            (alternate)
_arguments "${_arguments_options[@]}" : \
'-f+[Read input from a file instead of arguments or standard input]:PATH:_default' \
'--file=[Read input from a file instead of arguments or standard input]:PATH:_default' \
'-o+[Write the result to a file instead of standard output]:PATH:_default' \
'--out=[Write the result to a file instead of standard output]:PATH:_default' \
'--raw[Keep piped input exactly as read, including its trailing newline]' \
'(--whole)--lines[Apply the operation to each line separately]' \
'--whole[Apply the operation to the whole input at once]' \
'-n[Do not append a trailing newline to the result]' \
'--no-newline[Do not append a trailing newline to the result]' \
'-h[Print help]' \
'--help[Print help]' \
'*::INPUT -- Text to process; omit to read standard input:_default' \
&& ret=0
;;
